{
    "compilerOptions": {
        "target": "ES2023",
        "module": "node16",
        "moduleResolution": "node16",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "allowImportingTsExtensions": true,
        "rewriteRelativeImportExtensions": true,
        "declaration": true,
        "outDir": "./dist",
        "rootDir": ".",
        "noEmit": false,
        "types": ["node"]
    },
    "include": ["src/**/*.ts", "generated/**/*.ts"]
}
